#!/usr/bin/env bash
# What CI's rust and web jobs run (.github/workflows/ci.yml), here, before a push.
# A missing tool is an error, not a skip: a skipped lint is how a red CI happens.
# Only CI covers the MSRV build and the Windows and macOS runners.
set -euo pipefail
cd "$(dirname "$0")/.."

say() { printf '\033[1;35m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

missing=()
for tool in cargo npm shellcheck git; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if [ "${#missing[@]}" -gt 0 ]; then
    die "missing ${missing[*]} (shellcheck: pacman -S shellcheck, apt install shellcheck, brew install shellcheck)"
fi

say "cargo fmt"
cargo fmt --all -- --check
say "cargo clippy"
cargo clippy --workspace --all-targets --locked -- -D warnings
say "cargo test"
cargo test --workspace --locked --no-fail-fast
# The desktop app is behind a feature and needs the system webview to build. With
# it here (Linux: webkit2gtk-4.1), it's checked as CI's desktop job does.
if [ "$(uname -s)" != Linux ] || pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
    say "desktop app: cargo clippy, cargo test"
    cargo clippy -p valkyrie-desktop --features window --all-targets --locked -- -D warnings
    cargo test -p valkyrie-desktop --features window --locked --no-fail-fast
else
    say "desktop app: skipped, no webkit2gtk-4.1 here (CI's desktop job checks it)"
fi
say "shellcheck"
shellcheck install.sh install-release.sh .githooks/commit-msg scripts/check

say "web: npm ci, typecheck, test, build"
(
    cd web
    npm ci
    npm run typecheck
    npm test
    npm run build
)
if [ -n "$(git status --porcelain -- web/dist)" ]; then
    git status --porcelain -- web/dist
    die "web/dist is stale: commit the rebuilt web/dist"
fi

say "all of CI's checks pass here (MSRV, Windows and macOS run only in CI)"
